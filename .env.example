# Copy this file to .env and fill in your own values.

# MongoDB connection string (MongoDB Atlas or local)
ATLASDB_URL=mongodb://127.0.0.1:27017/rentique

# Long random string used to sign session cookies
SECRET=replace-with-a-long-random-string

# Port the server listens on (defaults to 8080)
PORT=8080

# Optional: _id of the user who can edit/delete any listing or review
ADMIN_ID=

# Used by `npm run seed`: _id of the user who will own the sample listings
SEED_OWNER_ID=
