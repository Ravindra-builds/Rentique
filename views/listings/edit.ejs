<% layout("/layouts/boilerplate") %>

<a class="back-link mb-3" href="/listings/<%= listing._id %>"><i class="fa-solid fa-arrow-left"></i> Back to listing</a>

<div class="page-head">
  <h1>Edit listing</h1>
  <p>Update the details for <strong><%= listing.title %></strong>.</p>
</div>

<%- include("../includes/listing-form.ejs", {
  listing: listing,
  action: `/listings/${listing._id}?_method=PUT`,
  submitLabel: "Save changes",
  cancelUrl: `/listings/${listing._id}`
}) %>
