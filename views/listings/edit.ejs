<% layout("/layouts/boilerplate")%>
<body>
    <h2 style="text-align: center;">Edit Listing</h2>
    <form method="post" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation">
       <div class="row offset-md-2 col-md-8">
         <div>
             <label for="title" class="form-label"><b>Title</b></label>
           <input type="text" id="title" name="listing[title]" value="<%= listing.title %>" required class="form-control"> <br>
           <div class="invalid-feedback">Please provide a title!</div>

        </div>
         <div>
            <label for="description" class="form-label"><b>Description</b></label>
        <textarea id="description" name="listing[description]" required class="form-control"><%= listing.description %></textarea><br>
        <div class="invalid-feedback">Please provide a description!</div>
         </div>
        <div class="row">
            <div class="col-6">
            <label for="price" class="form-label"><b>Price per day</b></label>
            <input type="number" id="price" name="listing[price]" value="<%= listing.price %>" required class="form-control"><br>
            <div class="invalid-feedback">Please provide a price!</div>
        </div>
        <div class="col-6">
            <label for="country" class="form-label"><b>Country</b></label>
            <input type="text" id="country" name="listing[country]" value="<%= listing.country %>" required class="form-control"><br>
        </div>
        </div>
        <div>
            <label for="imageUrl" class="form-label"><b>Image URL</b></label>
        <input type="text" id="imageUrl" name="listing[imageUrl]" value="<%= listing.imageUrl %>" class="form-control"><br>
        </div>
        <div>
            <label for="location" class="form-label"><b>Location</b></label>
            <input type="text" id="location" name="listing[location]" value="<%= listing.location %>" required class="form-control" ><br>
        </div>
       </div>

        <button type="submit" class="btn btn-primary offset-md-2 mb-2">Update Listing</button>
    </form>
</body>
