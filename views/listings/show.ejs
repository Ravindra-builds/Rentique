<% layout("/layouts/boilerplate")%>
 <script>
    const listing = <%-JSON.stringify(listing) %>;
 </script>
   <div class=" row offset-md-2 col-md-8 show-cards">
     <img src="<%=listing.imageUrl%>" alt="img" class="show-card-img rounded-3" style="max-width:900px; max-height:400px;">
     <p>Owned-by:<i><%=listing.owner.username%></i></p>
    <h2><%= listing.title %></h2>
    <p><%= listing.description %></p>
    <p><b>Price:</b> &#8377;<%= listing.price.toLocaleString("en-IN") %> per day</p>
    <p><b>Country:</b> <%= listing.country %></p>
    <p><b>Location:</b><%= listing.location %></p>
   </div>
   <%if(currUser && (currUser._id.equals(listing.owner._id)||currUser._id.equals(adminId))){%>
  <div class="row offset-md-2 mb-4 mt-3 show-btns">
    <div class="col-md-2">
         <form action="/listings/<%= listing._id %>/edit" method="get">
        <button type="submit" class="btn btn-primary edit-btn">Edit Listing</button>
    </form>
    </div>
   <div class="col-md-4">
     <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
        <button type="submit" class="btn btn-danger delete-btn">Delete Listing</button>
    </form>
   </div>
  </div>
   <%}%>
   <hr>
   <%if(!currUser){ %>
    <a href="/login"><button class="btn btn-outline-primary offset-md-2 mb-2">Login to Leave a Review</button></a>
    <% } %>

   <%  let reviewed = false; 
   if(currUser){
     reviewed=listing.reviews.some(r =>r.author.equals(currUser._id));
   }%>
   <%if(currUser && !reviewed ){ %>
   <p class="offset-md-2"><b>Leave a Review here!</b></p>
    <form method="post" action="/listings/<%= listing._id %>/reviews"class=" offset-md-2 px-2 needs-validation" novalidate>
     <div class=" row col-md-6">

 <fieldset class="starability-slot">
  <legend>Rating</legend>
  <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2" name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3" name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4" name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5" name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>

      <label for="comment" class="form-label mt-3">Comments</label>
      <textarea id="comment" name="review[comment]" rows="5" cols="20" class="form-control review-comment p-2" required></textarea>
      <div class="invalid-feedback">Add some Comments please!</div>
     </div>
      <button type="submit" class="btn btn-outline-primary mb-4 mt-3">Submit</button>
    </form>
    <hr>
   <% } %>
    <% if(listing.reviews.length>0){ %>
    <h2 class="offset-md-2">All reviews</h2>
        <div class="row offset-md-2 col-md-10 mb-5 review-items">
         <% for(let review of listing.reviews){ %>
         <div class="card mb-3 col-md-5 ms-2">
            <div class="card-body review-card">
               <p><b><i class="fa-solid fa-circle-user"></i><i> <%=review.author.username%></i></b></p>
                <p class="starability-result card-text" data-rating="<%= review.rating %>">Rated: <%= review.rating %></p>
               <p class="card-text"><%= review.comment %></p>

            </div>
           <% if(currUser && (currUser._id.equals(review.author._id)||currUser._id.equals(adminId))){%>
            <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="post">
               <button type="submit" class="btn btn-sm btn-outline-danger delete-review"><i class="fa-solid fa-trash-can"></i></button>
            </form>
           <%}%>
         </div>
         <% } %>
      </div>
      <% } %>
 <h4 class="offset-md-2 p-2">See the Location <i class="fa-solid fa-location-dot"></i></h4>
 <div class="offset-md-2" id="map"></div>
 <script>
 coordinates=listing.geometry.coordinates;
  var map = L.map('map').setView([coordinates[1],coordinates[0]], 12);
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    maxZoom: 19,
    // attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
}).addTo(map);
  const redIcon = L.icon({
    iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-red.png',
    shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-shadow.png',
    iconSize: [25, 41],
    iconAnchor: [12, 41],
    popupAnchor: [1, -34],
    shadowSize: [41, 41]
  });
var marker = L.marker(coordinates.reverse(),{icon:redIcon}).addTo(map);
marker.bindPopup("<b><%=listing.location%></b><br>There is your Location!").openPopup();
 </script>
