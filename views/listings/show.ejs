<% layout("/layouts/boilerplate") %>
<%
  const isAdmin = currUser && adminId && currUser._id.equals(adminId);
  const canManage = currUser && ((listing.owner && currUser._id.equals(listing.owner._id)) || isAdmin);
  const reviewCount = listing.reviews.length;
  const avgRating = reviewCount
    ? (listing.reviews.reduce((sum, r) => sum + r.rating, 0) / reviewCount).toFixed(1)
    : null;
  const hasReviewed = currUser && listing.reviews.some(r => r.author && r.author._id.equals(currUser._id));
  const coords = listing.geometry && listing.geometry.coordinates;
  const hasCoords = Array.isArray(coords) && coords.length === 2 && !(coords[0] === 0 && coords[1] === 0);
  const ownerName = listing.owner ? listing.owner.username : "Rentique host";
  const place = listing.country && !listing.location.toLowerCase().includes(listing.country.toLowerCase())
    ? `${listing.location}, ${listing.country}`
    : listing.location;
%>

<a class="back-link mb-3" href="/listings"><i class="fa-solid fa-arrow-left"></i> All stays</a>

<header class="fade-up">
  <h1 class="listing-title"><%= listing.title %></h1>
  <div class="listing-meta">
    <% if (avgRating) { %>
      <span class="rating-summary"><i class="fa-solid fa-star"></i><strong><%= avgRating %></strong> · <%= reviewCount %> <%= reviewCount === 1 ? "review" : "reviews" %></span>
    <% } else { %>
      <span><i class="fa-solid fa-wand-magic-sparkles me-1"></i>New listing</span>
    <% } %>
    <span><i class="fa-solid fa-location-dot me-1"></i><%= place %></span>
  </div>
</header>

<div class="listing-hero fade-up">
  <img src="<%= listing.imageUrl %>" alt="<%= listing.title %>" class="js-fallback">
</div>

<div class="row g-4 g-lg-5">
  <div class="col-lg-8">
    <div class="host-row pb-4">
      <span class="avatar avatar-lg"><%= ownerName.charAt(0) %></span>
      <div>
        <div class="fw-semibold text-dark">Hosted by <%= ownerName %></div>
        <div class="small text-muted-2">Verified Rentique host</div>
      </div>
    </div>

    <section class="content-section">
      <h2>About this place</h2>
      <p class="description mb-0"><%= listing.description %></p>
    </section>

    <section class="content-section" id="reviews">
      <h2>
        <% if (avgRating) { %>
          <span class="rating-summary"><i class="fa-solid fa-star"></i> <%= avgRating %> · <%= reviewCount %> <%= reviewCount === 1 ? "review" : "reviews" %></span>
        <% } else { %>
          Reviews
        <% } %>
      </h2>

      <% if (!currUser) { %>
        <div class="review-form d-flex flex-wrap align-items-center justify-content-between gap-3">
          <span>Stayed here? Share your experience with other guests.</span>
          <a class="btn btn-ghost" href="/login">Log in to review</a>
        </div>
      <% } else if (!hasReviewed) { %>
        <form method="post" action="/listings/<%= listing._id %>/reviews" class="review-form needs-validation" novalidate>
          <fieldset class="starability-slot mb-2">
            <legend>Your rating</legend>
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>

          <label for="comment" class="form-label">Your review</label>
          <textarea id="comment" name="review[comment]" rows="4" class="form-control" placeholder="What did you like about your stay?" required></textarea>
          <div class="invalid-feedback">Please write a few words about your stay.</div>

          <button type="submit" class="btn btn-brand mt-3">Post review</button>
        </form>
      <% } %>

      <% if (reviewCount === 0) { %>
        <p class="text-muted-2 mb-0">No reviews yet — be the first to share your experience.</p>
      <% } else { %>
        <div class="review-grid">
          <% for (let review of listing.reviews) { %>
            <% const authorName = review.author ? review.author.username : "Former guest"; %>
            <article class="review-card">
              <div class="review-head">
                <span class="avatar"><%= authorName.charAt(0) %></span>
                <div>
                  <div class="review-author"><%= authorName %></div>
                  <% if (review.createdAt) { %>
                    <div class="review-date"><%= new Date(review.createdAt).toLocaleDateString("en-IN", { month: "long", year: "numeric" }) %></div>
                  <% } %>
                </div>
              </div>
              <p class="starability-result" data-rating="<%= review.rating %>">Rated: <%= review.rating %> stars</p>
              <p class="review-text"><%= review.comment %></p>

              <% if (currUser && ((review.author && currUser._id.equals(review.author._id)) || isAdmin)) { %>
                <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="post" data-confirm="Delete this review?">
                  <button type="submit" class="btn btn-sm btn-danger-soft review-delete" aria-label="Delete review"><i class="fa-solid fa-trash-can"></i></button>
                </form>
              <% } %>
            </article>
          <% } %>
        </div>
      <% } %>
    </section>

    <section class="content-section">
      <h2>Where you’ll be</h2>
      <p class="text-muted-2"><%= place %></p>
      <% if (hasCoords) { %>
        <div id="map" data-lng="<%= coords[0] %>" data-lat="<%= coords[1] %>" data-label="<%= listing.location %>"></div>
      <% } else { %>
        <div class="empty-state py-4">
          <p class="text-muted-2 mb-0"><i class="fa-solid fa-map me-2"></i>Map location isn’t available for this listing yet.</p>
        </div>
      <% } %>
    </section>
  </div>

  <div class="col-lg-4 order-first order-lg-last">
    <aside class="price-card">
      <div class="price">&#8377;<%= listing.price.toLocaleString("en-IN") %> <small>/ day</small></div>

      <dl>
        <div><dt>Location</dt><dd><%= listing.location %></dd></div>
        <div><dt>Country</dt><dd><%= listing.country %></dd></div>
        <div><dt>Rating</dt><dd><%= avgRating ? `${avgRating} / 5` : "No ratings yet" %></dd></div>
      </dl>

      <% if (canManage) { %>
        <div class="d-grid gap-2">
          <a class="btn btn-brand" href="/listings/<%= listing._id %>/edit"><i class="fa-solid fa-pen me-2"></i>Edit listing</a>
          <form action="/listings/<%= listing._id %>?_method=DELETE" method="post" class="d-grid" data-confirm="Delete this listing? This also removes all of its reviews.">
            <button type="submit" class="btn btn-danger-soft"><i class="fa-solid fa-trash-can me-2"></i>Delete listing</button>
          </form>
        </div>
      <% } else { %>
        <div class="d-grid">
          <a class="btn btn-brand" href="#reviews"><i class="fa-regular fa-comment me-2"></i>Read reviews</a>
        </div>
        <p class="small text-muted-2 text-center mt-3 mb-0">Hosted by <%= ownerName %></p>
      <% } %>
    </aside>
  </div>
</div>
