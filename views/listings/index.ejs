<% layout("/layouts/boilerplate") %>
<% const isSearch = typeof query === "string" && query.length > 0; %>

<% if (!isSearch) { %>
  <% const [phoneStay, tabletStay] = listings; %>
  <section class="showcase">
    <div class="container">
      <div class="showcase-head fade-up">
        <span class="showcase-badge">
          <i class="fa-solid fa-location-dot"></i>
          <%= listings.length ? `${listings.length} stays across India` : "New stays every week" %>
        </span>
        <h1>Discover your <span class="text-brand">perfect stay</span></h1>
        <p>Apartments, villas and cozy rooms hosted by real people across India.</p>
      </div>

      <div class="device-stage fade-up">
        <!-- Laptop: the real search lives inside its screen -->
        <div class="laptop">
          <div class="laptop-lid">
            <div class="laptop-screen">
              <div class="browser-bar" aria-hidden="true">
                <span class="dot"></span><span class="dot"></span><span class="dot"></span>
                <span class="browser-url"><i class="fa-solid fa-lock"></i> rentique</span>
              </div>
              <div class="screen-hero">
                <div class="screen-slides" aria-hidden="true"><span></span><span></span><span></span></div>
                <h2>Where do you want to go?</h2>
                <form class="hero-search" method="get" action="/search" role="search">
                  <i class="fa-solid fa-magnifying-glass hero-search-icon" aria-hidden="true"></i>
                  <input type="search" name="search" placeholder="Search a city…" aria-label="Search destinations" required>
                  <button class="btn btn-brand" type="submit">Search</button>
                </form>
                <div class="city-chips">
                  <% ["New Delhi", "Mumbai", "Goa", "Pune", "Chennai"].forEach(city => { %>
                    <a class="city-chip" href="/search?search=<%= encodeURIComponent(city) %>"><%= city %></a>
                  <% }) %>
                </div>
              </div>
            </div>
          </div>
          <div class="laptop-base" aria-hidden="true"></div>
        </div>

        <!-- Phone and tablet preview real listings -->
        <% if (phoneStay) { %>
          <a class="device device-phone" href="/listings/<%= phoneStay._id %>" aria-label="View <%= phoneStay.title %>">
            <div class="device-screen">
              <span class="phone-notch" aria-hidden="true"></span>
              <img src="<%= phoneStay.imageUrl %>" alt="" class="js-fallback" loading="lazy">
              <div class="device-card">
                <strong><%= phoneStay.title %></strong>
                <span class="device-muted"><%= phoneStay.location %></span>
                <span class="price">&#8377;<%= phoneStay.price.toLocaleString("en-IN") %> <small>/ day</small></span>
                <span class="device-pill device-pill-block">View stay</span>
              </div>
            </div>
          </a>
        <% } %>

        <% if (tabletStay) { %>
          <a class="device device-tablet" href="/listings/<%= tabletStay._id %>" aria-label="View <%= tabletStay.title %>">
            <div class="device-screen">
              <img src="<%= tabletStay.imageUrl %>" alt="" class="js-fallback" loading="lazy">
              <div class="device-card">
                <strong><%= tabletStay.title %></strong>
                <span class="device-muted"><i class="fa-solid fa-location-dot me-1"></i><%= tabletStay.location %></span>
                <div class="device-row">
                  <span class="price">&#8377;<%= tabletStay.price.toLocaleString("en-IN") %> <small>/ day</small></span>
                  <span class="device-pill">View</span>
                </div>
              </div>
            </div>
          </a>
        <% } %>
      </div>

      <ul class="showcase-features">
        <li>
          <span class="feature-icon"><i class="fa-solid fa-magnifying-glass"></i></span>
          <div><strong>Browse stays</strong><span>Search homes by city or name</span></div>
        </li>
        <li>
          <span class="feature-icon"><i class="fa-solid fa-star"></i></span>
          <div><strong>Real guest reviews</strong><span>Ratings from real guests</span></div>
        </li>
        <li>
          <a href="/listings/new" class="stretched-link" aria-label="List your place"></a>
          <span class="feature-icon"><i class="fa-solid fa-key"></i></span>
          <div><strong>Host with ease</strong><span>List your place in minutes</span></div>
        </li>
      </ul>
    </div>
  </section>
<% } %>

<div class="section-head" id="stays">
  <div>
    <h2><%= isSearch ? `Stays matching “${query}”` : "Explore stays" %></h2>
    <p class="text-muted-2 mb-0 small">
      <%= listings.length %> <%= listings.length === 1 ? "place" : "places" %> available
    </p>
  </div>
  <% if (isSearch) { %>
    <a class="btn btn-ghost btn-sm" href="/listings"><i class="fa-solid fa-xmark me-1"></i>Clear search</a>
  <% } %>
</div>

<% if (listings.length === 0) { %>
  <div class="empty-state">
    <span class="icon"><i class="fa-solid fa-map-location-dot"></i></span>
    <h3 class="h5">No stays found</h3>
    <p class="text-muted-2 mb-4">Try another city, or be the first to list a place here.</p>
    <a class="btn btn-ghost me-2" href="/listings">Browse all stays</a>
    <a class="btn btn-brand" href="/listings/new">List your place</a>
  </div>
<% } else { %>
  <div class="listing-grid">
    <% for (let listing of listings) { %>
      <a class="listing-card fade-up" href="/listings/<%= listing._id %>">
        <div class="listing-card-media">
          <img src="<%= listing.imageUrl %>" alt="<%= listing.title %>" loading="lazy" class="js-fallback">
          <span class="listing-card-badge">
            <% if (listing.reviews && listing.reviews.length) { %>
              <i class="fa-solid fa-star text-warning me-1"></i><%= listing.reviews.length %> <%= listing.reviews.length === 1 ? "review" : "reviews" %>
            <% } else { %>
              New
            <% } %>
          </span>
        </div>
        <div class="listing-card-body">
          <h3 class="listing-card-title"><%= listing.title %></h3>
          <p class="listing-card-location"><%= listing.location %></p>
          <span class="price">&#8377;<%= listing.price.toLocaleString("en-IN") %> <small>/ day</small></span>
        </div>
      </a>
    <% } %>
  </div>
<% } %>
