
<% if(success && success.length) {%>
    <div class="alert alert-success alert-dismissible  offset-2 col-8" role="alert">
        <%= success %>
   <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<%}%>
 <%if(error && error.length) {%>
    <div class="alert alert-danger alert-dismissible offset-2 col-8" role="alert">
        <%= error %>
   <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<%}%>